<?xml version="1.0" encoding="UTF-8"?>
<!-- Student profiles chosen at the start of a game, with their initial statistics. Ids are unique. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:include schemaLocation="common.xsd"/>

    <xs:element name="profiles">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="profile" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="name" type="nonBlankText"/>
                            <xs:element name="description" type="nonBlankText"/>
                        </xs:sequence>
                        <xs:attribute name="id" type="identifier" use="required"/>
                        <xs:attribute name="knowledge" type="nonNegativeValue" use="required"/>
                        <xs:attribute name="energy" type="positiveValue" use="required"/>
                        <xs:attribute name="concentration" type="nonNegativeValue" use="required"/>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
        <xs:key name="profileId">
            <xs:selector xpath="profile"/>
            <xs:field xpath="@id"/>
        </xs:key>
    </xs:element>
</xs:schema>
