<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="14" styleClass="screen" xmlns:fx="http://javafx.com/fxml">
    <padding>
        <Insets top="32" right="40" bottom="32" left="40"/>
    </padding>
    <Label text="Nuova partita" styleClass="title"/>
    <VBox spacing="8" styleClass="card" maxWidth="520">
        <Label text="Come ti chiami?" styleClass="section"/>
        <TextField fx:id="nameField" promptText="Il tuo nome" onAction="#onStart"/>
        <Label text="Che studente sei?" styleClass="section"/>
        <ListView fx:id="profiles" prefHeight="250"/>
        <Label fx:id="errorLabel" styleClass="error" wrapText="true"/>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Indietro" onAction="#onBack" styleClass="link"/>
            <Button text="Inizia la sessione" onAction="#onStart" styleClass="primary"/>
        </HBox>
    </VBox>
</VBox>
