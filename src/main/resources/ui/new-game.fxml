<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page" xmlns:fx="http://javafx.com/fxml">
    <VBox styleClass="headline">
        <Label text="Nuova partita" styleClass="title"/>
        <Label text="Scegli il tuo nome e che studente sei." styleClass="subtitle"/>
    </VBox>
    <VBox styleClass="card">
        <Label text="Come ti chiami?" styleClass="section"/>
        <TextField fx:id="nameField" promptText="Il tuo nome" onAction="#onStart"/>
        <Label text="Che studente sei?" styleClass="section"/>
        <ListView fx:id="profiles" prefHeight="226"/>
        <Label fx:id="errorLabel" styleClass="error" wrapText="true"/>
        <HBox styleClass="row">
            <Button text="Indietro" onAction="#onBack" styleClass="link"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Come si gioca" onAction="#onHowToPlay" styleClass="secondary"/>
            <Button text="Inizia la sessione" onAction="#onStart" styleClass="primary"/>
        </HBox>
    </VBox>
</VBox>
