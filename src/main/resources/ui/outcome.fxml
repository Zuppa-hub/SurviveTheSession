<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="18" styleClass="screen" xmlns:fx="http://javafx.com/fxml">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>
    <Label fx:id="examLabel" styleClass="subtitle"/>
    <Label fx:id="titleLabel" styleClass="title"/>
    <VBox spacing="10" styleClass="card" maxWidth="460" alignment="CENTER_LEFT">
        <Label fx:id="gradeLabel" styleClass="grade"/>
        <VBox fx:id="detailsBox" spacing="6"/>
        <HBox alignment="CENTER_RIGHT">
            <Button fx:id="continueButton" onAction="#onContinue" styleClass="primary"/>
        </HBox>
    </VBox>
</VBox>
