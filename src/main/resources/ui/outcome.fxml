<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page" xmlns:fx="http://javafx.com/fxml">
    <VBox styleClass="headline">
        <Label fx:id="titleLabel" styleClass="title"/>
        <Label fx:id="examLabel" styleClass="subtitle"/>
    </VBox>
    <VBox styleClass="card">
        <Label fx:id="gradeLabel" styleClass="grade"/>
        <VBox fx:id="detailsBox" styleClass="stack"/>
        <HBox styleClass="actions">
            <Button fx:id="continueButton" onAction="#onContinue" styleClass="primary"/>
        </HBox>
    </VBox>
</VBox>
