<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="screen" xmlns:fx="http://javafx.com/fxml">
    <top>
        <VBox styleClass="stack, gap-bottom">
            <HBox styleClass="header">
                <HBox styleClass="row" alignment="BASELINE_LEFT">
                    <Label fx:id="examLabel" styleClass="title"/>
                    <Label fx:id="examDetailsLabel" styleClass="subtitle"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="timerLabel" styleClass="timer"/>
                <Button text="Ritirati" onAction="#onRetire" styleClass="link"/>
            </HBox>
            <HBox styleClass="card, wide">
                <VBox styleClass="tight" HBox.hgrow="ALWAYS">
                    <Label fx:id="resistanceLabel"/>
                    <ProgressBar fx:id="resistanceBar" maxWidth="Infinity" styleClass="resistance"/>
                </VBox>
                <VBox styleClass="tight" HBox.hgrow="ALWAYS">
                    <Label fx:id="energyLabel"/>
                    <ProgressBar fx:id="energyBar" maxWidth="Infinity" styleClass="energy"/>
                </VBox>
                <VBox styleClass="tight" HBox.hgrow="ALWAYS">
                    <Label fx:id="concentrationLabel"/>
                    <ProgressBar fx:id="concentrationBar" maxWidth="Infinity" styleClass="concentration"/>
                </VBox>
            </HBox>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="plain">
            <VBox styleClass="card">
                <HBox styleClass="row">
                    <Label fx:id="difficultyLabel" styleClass="chip"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="feedbackLabel" wrapText="true"/>
                </HBox>
                <Label fx:id="promptLabel" styleClass="prompt" wrapText="true"/>
                <HBox styleClass="wide">
                    <Label fx:id="codeLabel" styleClass="code" minWidth="-Infinity"/>
                    <VBox styleClass="options" HBox.hgrow="ALWAYS">
                        <Label fx:id="hintLabel" styleClass="hint" wrapText="true"/>
                        <VBox fx:id="optionsBox" styleClass="options"/>
                        <HBox fx:id="answerBox" styleClass="row">
                            <TextField fx:id="answerField" promptText="Scrivi la risposta" onAction="#onSubmit"
                                       HBox.hgrow="ALWAYS"/>
                            <Button text="Rispondi" onAction="#onSubmit" styleClass="primary"/>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
    <bottom>
        <VBox styleClass="gap-top">
            <VBox styleClass="card">
                <HBox styleClass="row">
                    <Label text="Zaino e abilità" styleClass="section"/>
                    <Label fx:id="boostLabel" styleClass="success"/>
                </HBox>
                <FlowPane fx:id="actionsBox" hgap="8" vgap="8" styleClass="compact"/>
            </VBox>
        </VBox>
    </bottom>
</BorderPane>
