<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page" xmlns:fx="http://javafx.com/fxml">
    <VBox styleClass="headline">
        <Label text="Sopravvivi alla Sessione" styleClass="title"/>
        <Label text="Supera tutti gli esami della sessione e laureati." styleClass="subtitle"/>
    </VBox>
    <VBox styleClass="card">
        <Button text="Nuova partita" onAction="#onNewGame" styleClass="primary" maxWidth="Infinity"/>
        <Button text="Come si gioca" onAction="#onHowToPlay" styleClass="secondary" maxWidth="Infinity"/>
    </VBox>
    <VBox styleClass="card">
        <Label text="Partite salvate" styleClass="section"/>
        <ListView fx:id="savedGames" prefHeight="150"/>
        <HBox styleClass="actions">
            <Button fx:id="loadButton" text="Carica partita" onAction="#onLoad" styleClass="secondary"/>
        </HBox>
    </VBox>
    <Button text="Esci" onAction="#onExit" styleClass="link"/>
</VBox>
