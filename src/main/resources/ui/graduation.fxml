<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="16" styleClass="screen" xmlns:fx="http://javafx.com/fxml">
    <padding>
        <Insets top="36" right="40" bottom="36" left="40"/>
    </padding>
    <Label text="Laurea" styleClass="subtitle"/>
    <Label fx:id="congratulationsLabel" styleClass="title"/>
    <Label fx:id="finalGradeLabel" styleClass="grade, success"/>
    <VBox spacing="8" styleClass="card" maxWidth="520">
        <Label text="Libretto" styleClass="section"/>
        <ListView fx:id="exams" prefHeight="220"/>
        <HBox spacing="16">
            <Label fx:id="averageLabel"/>
            <Label fx:id="creditsLabel"/>
        </HBox>
        <HBox alignment="CENTER_RIGHT">
            <Button text="Torna al menu" onAction="#onMenu" styleClass="primary"/>
        </HBox>
    </VBox>
</VBox>
