<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page" xmlns:fx="http://javafx.com/fxml">
    <VBox styleClass="headline">
        <Label fx:id="congratulationsLabel" styleClass="title"/>
        <Label text="Hai superato tutti gli esami della sessione." styleClass="subtitle"/>
    </VBox>
    <VBox styleClass="card">
        <Label fx:id="finalGradeLabel" styleClass="grade, success"/>
        <Label text="Libretto" styleClass="section"/>
        <ListView fx:id="exams" prefHeight="200"/>
        <HBox styleClass="row">
            <Label fx:id="averageLabel"/>
            <Label fx:id="creditsLabel"/>
        </HBox>
        <HBox styleClass="actions">
            <Button text="Torna al menu" onAction="#onMenu" styleClass="primary"/>
        </HBox>
    </VBox>
</VBox>
